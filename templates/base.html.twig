<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GestEns{% endblock %}</title>
    
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_home') }}">GestEns</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="coursDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Cours
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="coursDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_cours_index') }}">Tous les cours</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_cours_new') }}">Créer un cours</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="formationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Formations
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="formationDropdown">
                            <li><a class="dropdown-item" href="{{ path('app_formation_index') }}">Toutes les formations</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_formation_new') }}">Créer une formation</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    
    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>
    
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}
</body>
</html>