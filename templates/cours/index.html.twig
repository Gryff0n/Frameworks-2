{% extends 'base.html.twig' %}
{% block title %}Liste des cours{% endblock %}
{% block body %}
    <h1 class="mb-4">Liste des cours</h1>
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Semestre</th>
                <th>Nom</th>
                <th>Formation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cours in cours %}
            <tr>
                <td>{{ cours.semestre }}</td>
                <td>
                    <a href="{{ path('app_cours_show', {'id': cours.id}) }}" class="text-decoration-none">
                        {{ cours.nom }}
                    </a>
                </td>
                <td>
                    {% if cours.formations|length > 0 %}
                        {% for formation in cours.formations %}
                            <span class="badge bg-primary">{{ formation.niveau }}</span>
                            {{ formation.intitule }}
                            {% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                    {% else %}
                        <span class="text-muted">Aucune formation</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('app_cours_show', {'id': cours.id}) }}" class="btn btn-sm btn-info">Voir</a>
                    <a href="{{ path('app_cours_edit', {'id': cours.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center">Aucun cours trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_cours_new') }}" class="btn btn-primary">Créer un nouveau cours</a>
{% endblock %}