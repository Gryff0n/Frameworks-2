{% extends 'base.html.twig' %}

{% block title %}Liste des cours{% endblock %}

{% block body %}
    <h1 class="mb-4">Liste des cours</h1>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Semestre</th>
                <th>Nom</th>
            </tr>
        </thead>
        <tbody>
        {% for cours in cours %}
            <tr>
                <td>{{ cours.semestre }}</td>
                <td>
                    <a href="{{ path('app_cours_show', {'id': cours.id}) }}" class="text-decoration-none">
                        {{ cours.nom }}
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2" class="text-center">Aucun cours trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cours_new') }}" class="btn btn-primary">Créer un nouveau cours</a>
{% endblock %}