{% extends 'base.html.twig' %}

{% block title %}Nouveau cours{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Créer un nouveau cours</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom, 'Nom du cours', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.semestre, 'Semestre', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.semestre, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.semestre) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.Description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.Description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                            {{ form_errors(form.Description) }}
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_cours_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Enregistrer
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}