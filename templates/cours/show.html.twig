{% extends 'base.html.twig' %}

{% block title %}{{ cour.nom }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1 class="mb-4">{{ cour.nom }}</h1>
            
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">Semestre</th>
                                <td>Semestre {{ cour.semestre }}</td>
                            </tr>
                            <tr>
                                <th>ECTS</th>
                                <td>
                                    <span class="badge bg-success">{{ cour.ects }} ECTS</span>
                                </td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ cour.Description|markdown_to_html }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Volume horaire</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted">Cours Magistraux</h6>
                                    <h3 class="text-primary">{{ cour.heureCM }}h</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted">Travaux Dirigés</h6>
                                    <h3 class="text-success">{{ cour.heureTD }}h</h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-muted">Travaux Pratiques</h6>
                                    <h3 class="text-warning">{{ cour.heureTP }}h</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 text-center">
                        <strong>Volume total : </strong>
                        <span class="badge bg-dark fs-5">
                            {{ cour.heureCM + cour.heureTD + cour.heureTP }}h
                        </span>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="{{ path('app_cours_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_cours_edit', {'id': cour.id}) }}" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
                {{ include('cours/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}