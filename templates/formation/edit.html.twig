{% extends 'base.html.twig' %}
{% block title %}Modifier une formation{% endblock %}
{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4">Modifier la formation : {{ formation.niveau }} {{ formation.intitule }}</h1>
            
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Informations de la formation</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        
                        {# Informations générales #}
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <h6 class="text-warning border-bottom pb-2">Informations générales</h6>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.niveau, 'Niveau', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.niveau, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Licence, Master, Doctorat'}}) }}
                                    {{ form_errors(form.niveau) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.parcours, 'Parcours', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.parcours, {'attr': {'class': 'form-control', 'placeholder': 'Ex: MIAGE, Classique'}}) }}
                                    {{ form_errors(form.parcours) }}
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="mb-3">
                                    {{ form_label(form.intitule, 'Intitulé', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                                    {{ form_widget(form.intitule, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Informatique, Mathématiques'}}) }}
                                    {{ form_errors(form.intitule) }}
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <div>
                                <a href="{{ path('app_formation_show', {'id': formation.id}) }}" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Annuler
                                </a>
                                <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-list"></i> Liste des formations
                                </a>
                            </div>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Enregistrer les modifications
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
            
            <div class="mt-3">
                {{ include('formation/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}