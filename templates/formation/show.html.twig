{% extends 'base.html.twig' %}
{% block title %}{{ formation.niveau }} {{ formation.intitule }}{% endblock %}
{% block body %}
    <div class="row">
        <div class="col-md-10 mx-auto">
            <h1 class="mb-4">
                <span class="badge bg-primary">{{ formation.niveau }}</span>
                {{ formation.intitule }} - {{ formation.parcours }}
            </h1>
            
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Informations générales</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">Niveau</th>
                                <td><span class="badge bg-primary fs-6">{{ formation.niveau }}</span></td>
                            </tr>
                            <tr>
                                <th>Intitulé</th>
                                <td>{{ formation.intitule }}</td>
                            </tr>
                            <tr>
                                <th>Parcours</th>
                                <td>{{ formation.parcours }}</td>
                            </tr>
                            <tr>
                                <th>Nombre de cours</th>
                                <td>
                                    <span class="badge bg-info">{{ formation.cours|length }} cours</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {% if formation.cours|length > 0 %}
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Cours de cette formation</h5>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Semestre</th>
                                <th>Nom du cours</th>
                                <th>ECTS</th>
                                <th>Volume horaire</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for cours in formation.cours %}
                            <tr>
                                <td>S{{ cours.semestre }}</td>
                                <td>
                                    <a href="{{ path('app_cours_show', {'id': cours.id}) }}" class="text-decoration-none">
                                        {{ cours.nom }}
                                    </a>
                                </td>
                                <td><span class="badge bg-success">{{ cours.ects }} ECTS</span></td>
                                <td>{{ cours.heureCM + cours.heureTD + cours.heureTP }}h</td>
                                <td>
                                    <a href="{{ path('app_cours_show', {'id': cours.id}) }}" class="btn btn-sm btn-info">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% else %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Aucun cours associé à cette formation pour le moment.
            </div>
            {% endif %}

            <div class="mt-4">
                <a href="{{ path('app_formation_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_formation_edit', {'id': formation.id}) }}" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
                {{ include('formation/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}